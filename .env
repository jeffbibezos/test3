# ==============================================================================
# GitProtect Environment Configuration (.env)
# ==============================================================================
SECREC_KEY="2342"
# 1. Master Key ma hoa AES-256-GCM (64 ky tu hex = 32 bytes) - Bat buoc
GITPROTECT_AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 2. Database Connection URL (Su dung root khong mat khau cua Laragon)
DATABASE_URL=mysql+pymysql://root@localhost:3306/gitprotect_db?charset=utf8mb4

# 3. Database MySQL Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=gitprotect_db

# 4. Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# 5. Allowed Email Domains
ALLOWED_EMAIL_DOMAINS=organization.vn,gitprotect.io,ptit.edu.vn

# 6. Frontend Config
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000

# GitHub Webhook Callback URL (HTTPS required)
GITHUB_WEBHOOK_CALLBACK_URL=https://example.com/api/v1/webhooks/github
# [TEST RULE-05] So Can cuoc cong dan Viet Nam bi lo
